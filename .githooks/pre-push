#!/bin/sh
# Pre-push gate (mirrors validate.yml): unit tests, validate.py, actionlint, shellcheck.
# Enable once per checkout: git config core.hooksPath .githooks
# No package.json here, so no npm lint/typecheck; validate.py is the YAML lint.
set -eu
cd "$(git rev-parse --show-toplevel)"
PY=$(command -v python3 || command -v python)
echo "[pre-push] unittest"; "$PY" -m unittest discover -s tests
echo "[pre-push] validate.py"; "$PY" validate.py
if command -v actionlint >/dev/null 2>&1; then
  echo "[pre-push] actionlint"; actionlint .github/workflows/*.yml
else echo "[pre-push] WARNING: actionlint not installed, skipping" >&2; fi
if command -v shellcheck >/dev/null 2>&1; then
  files=$(git ls-files '*.sh')
  if [ -n "$files" ]; then echo "[pre-push] shellcheck"; echo "$files" | xargs shellcheck; fi
else echo "[pre-push] WARNING: shellcheck not installed, skipping" >&2; fi
echo "[pre-push] all checks passed"
