{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-12 * * 1"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "automergeType": "pr",
  "platformAutomerge": false,
  "internalChecksFilter": "strict",
  "ignoreTests": false,
  "configMigration": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-12 1 * *"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)requirements-dev\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "GitHub Actions: minor/patch/pin/digest in one PR (digest pins kept); majors get their own PR and are never merged automatically",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "github-actions non-major"
    },
    {
      "description": "GitHub Actions: wait 3 days after a new release (pin/digest refreshes of an already used tag are not delayed)",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "pip dev tooling: non-major in one PR (majors separate, never automerged)",
      "matchManagers": [
        "pip-compile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "pip non-major",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Automerge patch/pin/digest as a PR once ALL checks are green (Renovate itself waits for the checks, ignoreTests=false; no branch protection needed)",
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Automerge minor only for stable (non-0.x) versions; 0.x minors can break and get their own PR for review",
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "0.x minors (any manager; today only zizmor-action): own group, never automerged - 0.x minors can break",
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "/^0/",
      "groupName": "0.x minor",
      "automerge": false
    },
    {
      "description": "Majors never automerge",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
