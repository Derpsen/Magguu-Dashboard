#!/bin/sh
# Pre-push gate (mirrors validate.yml; plus docs drift words + docs-sync): unit tests, validate.py, actionlint, shellcheck.
# Enable once per checkout: git config core.hooksPath .githooks
# No package.json here, so no npm lint/typecheck; validate.py is the YAML lint.
set -eu
cd "$(git rev-parse --show-toplevel)"
# Marco rule 2026-10-25: every step runs via tools/run-limited.sh (hard limit, nice 19, idle I/O).
rl() { sh tools/run-limited.sh "$@"; }
PY=$(command -v python3 || command -v python)
echo "[pre-push] docs drift"; rl 60 bash tools/docs-drift.sh; rl 60 python3 tools/docs-sync.py
echo "[pre-push] unittest"; rl 900 "$PY" -m unittest discover -s tests
echo "[pre-push] validate.py"; rl 120 "$PY" validate.py
if command -v actionlint >/dev/null 2>&1; then
  echo "[pre-push] actionlint"; rl 120 actionlint .github/workflows/*.yml
else echo "[pre-push] WARNING: actionlint not installed, skipping" >&2; fi
if command -v shellcheck >/dev/null 2>&1; then
  files=$(git ls-files '*.sh' '.githooks/*')
  if [ -n "$files" ]; then echo "[pre-push] shellcheck"; echo "$files" | xargs sh tools/run-limited.sh 120 shellcheck; fi
else echo "[pre-push] WARNING: shellcheck not installed, skipping" >&2; fi
echo "[pre-push] all checks passed"
